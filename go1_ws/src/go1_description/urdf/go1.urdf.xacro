<?xml version="1.0"?>
<robot name="go1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="false"/>
  <xacro:arg name="ros_control_file" default=""/>
  <xacro:arg name="gazebo_gt_mode" default="public"/>
  <!-- Датчики по умолчанию - фронтальная RGB-D камера (голова, /camera) + 4 камеры Unitree (chin - в голове вниз,
       left, right, rearDown - в корпусе), всего 5; лидар выключен. Камеры Unitree у настоящего робота 928x800 @ 16 Гц,
       в симуляции по умолчанию облегчены (464x400 @ 10 Гц), полный размер - unitree_cam_width/height/rate. -->
  <xacro:arg name="lidar" default="false"/>
  <xacro:arg name="rgbd_camera" default="true"/>
  <xacro:arg name="unitree_cameras" default="true"/>
  <xacro:arg name="unitree_cam_width" default="464"/>
  <xacro:arg name="unitree_cam_height" default="400"/>
  <xacro:arg name="unitree_cam_rate" default="10"/>
  <xacro:arg name="DEBUG" default="false"/>

  <xacro:include filename="$(find go1_description)/urdf/const.xacro"/>
  <xacro:include filename="$(find go1_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find go1_description)/urdf/leg.xacro"/>
  <xacro:include filename="$(find go1_description)/urdf/gazebo.xacro"/>
  <xacro:include filename="$(find go1_description)/urdf/sensors/hokuyo.xacro"/>
  <xacro:include filename="$(find go1_description)/urdf/sensors/rgbd_camera.xacro"/>
  <xacro:include filename="$(find go1_description)/urdf/sensors/ultrasound.xacro"/>

  <xacro:if value="$(arg DEBUG)">
    <link name="world"/>
    <joint name="base_static_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.5"/>
      <parent link="world"/>
      <child link="trunk"/>
    </joint>
  </xacro:if>

  <link name="trunk">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://go1_description/meshes/trunk.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="${trunk_com_x} ${trunk_com_y} ${trunk_com_z}"/>
      <mass value="${trunk_mass}"/>
      <inertia
        ixx="${trunk_ixx}" ixy="${trunk_ixy}" ixz="${trunk_ixz}"
        iyy="${trunk_iyy}" iyz="${trunk_iyz}"
        izz="${trunk_izz}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="trunk"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="-0.01592 -0.06659 -0.00617"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size=".001 .001 .001"/>
      </geometry>
    </collision>
  </link>

  <xacro:leg name="FR" mirror="-1" front_hind="1">
    <origin rpy="0 0 0" xyz="${leg_offset_x} ${-leg_offset_y} 0"/>
  </xacro:leg>
  <xacro:leg name="FL" mirror="1" front_hind="1">
    <origin rpy="0 0 0" xyz="${leg_offset_x} ${leg_offset_y} 0"/>
  </xacro:leg>
  <xacro:leg name="RR" mirror="-1" front_hind="-1">
    <origin rpy="0 0 0" xyz="${-leg_offset_x} ${-leg_offset_y} 0"/>
  </xacro:leg>
  <xacro:leg name="RL" mirror="1" front_hind="-1">
    <origin rpy="0 0 0" xyz="${-leg_offset_x} ${leg_offset_y} 0"/>
  </xacro:leg>

  <!-- Крен камер 0 (у настоящего Go1 камеры стоят с креном 180 и кадр идёт вверх ногами), поэтому картинка в симуляции прямая -->
  <!-- face дублирует фронтальную RGB-D камеру (/camera), сенсор включается только при rgbd_camera=false. У face, left, right верх кадра совпадает с верхом корпуса (крен pi убран, меш повёрнут через vroll) -->
  <xacro:unitree_depth_camera name="face" enabled="${'$(arg unitree_cameras)' == 'true' and '$(arg rgbd_camera)' != 'true'}"
      width="$(arg unitree_cam_width)" height="$(arg unitree_cam_height)" rate="$(arg unitree_cam_rate)" vroll="${PI}">
    <origin rpy="0 0 0" xyz="0.2785 0.0125 0.0167"/>
  </xacro:unitree_depth_camera>
  <xacro:unitree_depth_camera name="chin" enabled="$(arg unitree_cameras)"
      width="$(arg unitree_cam_width)" height="$(arg unitree_cam_height)" rate="$(arg unitree_cam_rate)">
    <origin rpy="0 ${PI/2} 0" xyz="0.2522 0.0125 -0.0436"/>
  </xacro:unitree_depth_camera>
  <xacro:unitree_depth_camera name="left" enabled="$(arg unitree_cameras)"
      width="$(arg unitree_cam_width)" height="$(arg unitree_cam_height)" rate="$(arg unitree_cam_rate)" vroll="${PI}">
    <origin rpy="0 0.2618 ${PI/2}" xyz="-0.066 0.082 -0.0176"/>
  </xacro:unitree_depth_camera>
  <xacro:unitree_depth_camera name="right" enabled="$(arg unitree_cameras)"
      width="$(arg unitree_cam_width)" height="$(arg unitree_cam_height)" rate="$(arg unitree_cam_rate)" vroll="${PI}">
    <origin rpy="0 0.2618 ${-PI/2}" xyz="-0.041 -0.082 -0.0176"/>
  </xacro:unitree_depth_camera>
  <xacro:unitree_depth_camera name="rearDown" enabled="$(arg unitree_cameras)"
      width="$(arg unitree_cam_width)" height="$(arg unitree_cam_height)" rate="$(arg unitree_cam_rate)">
    <origin rpy="0 ${PI/2} 0" xyz="-0.0825 0.0125 -0.04365"/>
  </xacro:unitree_depth_camera>

  <joint name="camera_laserscan_joint_left" type="fixed">
    <origin rpy="0 0.2618 0" xyz="0 0 0"/>
    <parent link="camera_left"/>
    <child link="camera_laserscan_link_left"/>
  </joint>
  <link name="camera_laserscan_link_left"/>

  <joint name="camera_laserscan_joint_right" type="fixed">
    <origin rpy="0 0.2618 0" xyz="0 0 0"/>
    <parent link="camera_right"/>
    <child link="camera_laserscan_link_right"/>
  </joint>
  <link name="camera_laserscan_link_right"/>

  <xacro:ultrasound name="left">
    <origin rpy="0 0.2618 ${PI/2}" xyz="-0.0535 0.0826 0.00868"/>
  </xacro:ultrasound>
  <xacro:ultrasound name="right">
    <origin rpy="0 0.2618 ${-PI/2}" xyz="-0.0535 -0.0826 0.00868"/>
  </xacro:ultrasound>
  <xacro:ultrasound name="face">
    <origin rpy="0 0 0" xyz="0.2747 0.0 -0.0088"/>
  </xacro:ultrasound>

  <xacro:if value="$(arg lidar)">
    <xacro:laser name="base_scan" parent="trunk">
      <origin xyz="0.22 0 0.11" rpy="0 0 0"/>
    </xacro:laser>
  </xacro:if>

  <xacro:if value="$(arg rgbd_camera)">
    <xacro:front_rgbd_camera parent="trunk" enabled="$(arg sim)">
      <origin xyz="0.25 0 0.08" rpy="0 0 0"/>
    </xacro:front_rgbd_camera>
  </xacro:if>

</robot>
